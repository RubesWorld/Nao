<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nao.devfeed-server</string>

    <!-- devfeed.py serve: the page (~/Nao/external/devfeed/public) plus
         POST /api/advance for swipe-to-move, limited to config board.advance.
         --no-collect: com.nao.devfeed runs collect. Bound to the Tailscale IP
         (config "bind"), so nothing on the LAN or internet can reach it. If
         Tailscale is down at boot the bind fails and launchd retries
         (ThrottleInterval) until it comes up. devfeed-run.sh restarts this
         when it checks out a new pinned version. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/rubenmacmini/Nao/external/devfeed/devfeed.py</string>
        <string>serve</string>
        <string>--no-collect</string>
        <string>--config</string>
        <string>/Users/rubenmacmini/Nao/config/devfeed.json</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/rubenmacmini</string>
    </dict>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>WorkingDirectory</key>
    <string>/Users/rubenmacmini/Nao/external/devfeed/public</string>

    <key>StandardOutPath</key>
    <string>/Users/rubenmacmini/Nao/logs/devfeed-server.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/rubenmacmini/Nao/logs/devfeed-server.err</string>
</dict>
</plist>
