<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nao.calendar-capture</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/rubenmacmini/Nao/scripts/calendar-capture.py</string>
    </array>

    <!-- 21:30 nightly. Late enough that the evening's plans have actually
         happened (the proposer only offers events that have already ended),
         early enough that Ruben is still awake to answer. Silent on any night
         with nothing new — state/calendar-seen.json is what stops it
         re-proposing the same hangout. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/rubenmacmini/Nao</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/rubenmacmini</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/rubenmacmini/Nao/logs/calendar-capture.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/rubenmacmini/Nao/logs/calendar-capture.err</string>
</dict>
</plist>
