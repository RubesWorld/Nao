<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nao.devfeed-digest</string>

    <!-- Morning email: scripts/devfeed-digest.sh runs `devfeed.py digest`
         from the pinned release in external/devfeed and mails
         config/devfeed.json's digest.to. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/rubenmacmini/Nao/scripts/devfeed-digest.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/rubenmacmini/Nao</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/rubenmacmini</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/rubenmacmini/Nao/logs/devfeed-digest.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/rubenmacmini/Nao/logs/devfeed-digest.err</string>
</dict>
</plist>
